# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Supabase — from your Lovable/Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# ^ Use the SERVICE ROLE key, not the anon key — this service needs to
# read/write any user's project data and storage, not just its own.

# Video generation provider — choose ONE and fill in its key
VIDEO_PROVIDER=fal            # "fal" or "wavespeed"
FAL_API_KEY=your-fal-key-here
WAVESPEED_API_KEY=your-wavespeed-key-here

# Shared secret so only your Supabase Edge Function can trigger this service
# (generate a random string yourself, put the same string in both places)
SERVICE_AUTH_TOKEN=choose-a-long-random-string-here

# Server port (Render/Railway set this automatically, but a default is fine)
PORT=8080
