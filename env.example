# Copy to .env locally; on Render add these as Environment Variables.

# Shared secret - MUST match the RENDER_WEBHOOK_SECRET you gave Lovable
RENDER_WEBHOOK_SECRET=paste-the-same-64-char-hex-string-here

# Lovable's public API endpoints (from Lovable's "URLs for your service's env vars")
LOVABLE_STATUS_CALLBACK_URL=https://your-project.lovable.app/api/public/project-status
LOVABLE_UPLOAD_URL_ENDPOINT=https://your-project.lovable.app/api/public/render-upload-url

# Video generation provider
VIDEO_PROVIDER=fal
FAL_API_KEY=your-fal-key-here
WAVESPEED_API_KEY=your-wavespeed-key-here

PORT=8080
